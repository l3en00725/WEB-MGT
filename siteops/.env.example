# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google OAuth (platform-level app credentials)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://yourdomain.com/api/google/callback

# Google PageSpeed Insights
PAGESPEED_API_KEY=your-pagespeed-api-key

# Anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key

# Keywords Everywhere
KEYWORDS_EVERYWHERE_API_KEY=your-keywords-everywhere-api-key

# Inngest (for job queue)
INNGEST_EVENT_KEY=your-inngest-event-key
INNGEST_SIGNING_KEY=your-inngest-signing-key
INNGEST_DEV_SERVER_URL=http://localhost:8288

# Supabase Storage
NEXT_PUBLIC_SUPABASE_STORAGE_URL=https://your-project.supabase.co/storage/v1

# App
NEXT_PUBLIC_APP_URL=https://yourdomain.com
CRON_SECRET=your-cron-secret
